[sub_resource type="Resource" id="Resource_dinhu"]
script = ExtResource("3_vtaks")
name = "choise"
choises = Dictionary[String, String]({
"Агрессивно: Мне плевать, кто у тебя там голодный. Бензин не раздают бесплатно.": "agro",
"С сочувствием: Тяжело тебе, наверное... Давно ничего не ловил?": "good"
})
metadata/_custom_type_script = "uid://xy3l37ktt48x"

[sub_resource type="Resource" id="Resource_efysr"]
script = ExtResource("4_kvpfn")
name = "start"
replicas = Array[String](["Рыбак: Здорово. Слушай, мне бы немного бензина. Литров десять, если найдётся.", "Игрок: Зачем столько?", "Рыбак: На озере ещё осталась рыба. Но близко к берегу уже пусто. Придётся плыть дальше.", "Дома дети голодные, понимаешь?"])
next_choise = "choise"
metadata/_custom_type_script = "uid://cqdq3s3etltn0"

[sub_resource type="Resource" id="Resource_kvuet"]
script = ExtResource("4_kvpfn")
name = "good"
replicas = Array[String](["Рыбак (на сочувственный ответ): Третий день уже. Жена старается не показывать, но я вижу, как она переживает. Хоть бы сегодня повезло..."])
metadata/_custom_type_script = "uid://cqdq3s3etltn0"

[sub_resource type="Resource" id="Resource_trtic"]
script = ExtResource("4_kvpfn")
name = "agro"
replicas = Array[String](["Рыбак (на агрессивный ответ): Да уж, вижу, человечности тут не осталось. Ладно, сам как-нибудь справлюсь."])
metadata/_custom_type_script = "uid://cqdq3s3etltn0"

[sub_resource type="Resource" id="Resource_iywne"]
script = ExtResource("3_p57ef")
resume = "Я рыбак, и у мне нужно топливо,
чтобы рыбачит на своей лодке.
Мне нечем кормить семью"
social_networks = Array[String](["Пост №1 — за несколько месяцев до кризиса

Фото: утренний улов на фоне озера

Вот это я понимаю — удачная рыбалка! Сегодня даже пришлось второй раз возвращаться к берегу. Жена уже шутит, что скоро рыбу из дома выгонять придётся. Всем хорошего клёва!", "Пост №2 — начало кризиса

Фото: лодка у пустого берега

Что-то совсем невесело стало. Бензин дорожает, снасти дорожают, а рыбы всё меньше. Сегодня впервые за много лет вернулся домой с пустыми руками. Надеюсь, скоро всё наладится."])
start_dialog = "start"
dialogs = Array[ExtResource("4_kvpfn")]([SubResource("Resource_efysr"), SubResource("Resource_kvuet"), SubResource("Resource_trtic")])
choises = Array[ExtResource("3_vtaks")]([SubResource("Resource_dinhu")])
metadata/_custom_type_script = "uid://tic1p5mu7nxj"

