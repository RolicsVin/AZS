[sub_resource type="Resource" id="Resource_8ool0"]
script = ExtResource("3_pr1ej")
event_text = "Ты работник заправки!
К тебе каждый день приезжае
множество дюдей. Бензина мало
и на всех не хватит."
metadata/_custom_type_script = "uid://8nrd34x813vr"

[sub_resource type="Resource" id="Resource_pr1ej"]
script = ExtResource("3_pr1ej")
event_text = "Попробуй поговорить с новым посетителем. И сделай выбор:"
metadata/_custom_type_script = "uid://8nrd34x813vr"

[sub_resource type="Resource" id="Resource_05nbr"]
script = ExtResource("3_pr1ej")
event_text = "Зелёная кнопка - дать бензин.
Красная - отказать."
metadata/_custom_type_script = "uid://8nrd34x813vr"

[sub_resource type="Resource" id="Resource_oaba0"]
script = ExtResource("3_pr1ej")
event_text = "Снизу есть резюме человека - его можно прочитать."
metadata/_custom_type_script = "uid://8nrd34x813vr"

[sub_resource type="Resource" id="Resource_0sl42"]
script = ExtResource("3_pr1ej")
event_text = "Слева есть монитор - нажав на него
можно почитать недавнии посты
этого человека."
metadata/_custom_type_script = "uid://8nrd34x813vr"

[sub_resource type="Resource" id="Resource_458eo"]
script = ExtResource("3_pr1ej")
event_text = "Поздравляем! Ты закончил свою
первую смену. В награду за это
мы даём тебе подарок: Золотой куб"
anim_name = "gold_cube"
metadata/_custom_type_script = "uid://8nrd34x813vr"

